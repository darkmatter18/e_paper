# E-Paper Display Settings
# Note: Display dimensions (800x480) are fixed by Waveshare 7.5" B/V2 hardware
DISPLAY_FULL_REFRESH_INTERVAL=15

# Weather Service Settings
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_LATITUDE=23.426022
WEATHER_LONGITUDE=87.550644
WEATHER_UNITS=metric

# Timezone Settings (IST by default)
TIMEZONE_NAME=IST
TIMEZONE_UTC_OFFSET_HOURS=5
TIMEZONE_UTC_OFFSET_MINUTES=30

# Logging Settings
LOG_LEVEL=INFO

# API Authentication
# Generate password hash with: python generate_password_hash.py
# Leave AUTH_PASSWORD empty to disable authentication
AUTH_PASSWORD=$argon2id$v=19$m=65536,t=3,p=4$n4xJBgIW1okw1uNYcRvfiQ$4Upy6O9fP9+UVnYo3iHm+oXd2S8LfwUxrCQp3eDIQ7k
SECRET_KEY=your_secret_key_for_sessions_here
